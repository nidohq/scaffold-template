# Read by the `stellar` CLI (npm run dev, clients:testnet, deploy:testnet) and
# by Vite. Copy to .env; `npm run new-app` writes one for you.

# The network `npm run dev` builds clients for. Hosted Nido runs on testnet.
# `npm run deploy:testnet` deploys to testnet-dev and pins the new IDs under
# `testnet:` in scaffold.yml, so this stays `testnet`.
STELLAR_NETWORK=testnet

# The dev server's port. A Nido session lives in the page origin's storage,
# and the origin includes the port, so the port is fixed (strictPort) rather
# than drifting when another app holds it.
PORT=5173
