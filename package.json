{
  "name": "@stellar-scaffold/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "prestart": "node scripts/stellar.mjs --check",
    "start": "npm start --workspace app",
    "doctor": "node scripts/doctor.mjs",
    "tools:scaffold": "node scripts/tools-scaffold.mjs",
    "stellar": "node scripts/stellar.mjs",
    "clients:testnet": "node scripts/stellar.mjs scaffold build --build-clients --network testnet && node scripts/link-clients.mjs",
    "deploy:testnet": "node scripts/stellar.mjs scaffold build --build-clients --network testnet-dev && node scripts/pin-testnet.mjs && node scripts/link-clients.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "npm run build --workspace app",
    "test:unit": "vitest run",
    "test:e2e": "npm test --workspace e2e",
    "test-browser": "node scripts/test-browser.mjs",
    "link-clients": "node scripts/link-clients.mjs",
    "new-app": "node scripts/new-app.mjs",
    "prepare:prototype": "node scripts/prepare-prototype.mjs",
    "preview:prototype": "npm exec --workspace app -- vite --host 127.0.0.1 --port 5180"
  },
  "workspaces": [
    "app",
    "app-lib",
    "app-lib/clients/*",
    "e2e",
    "vendor/*"
  ],
  "devDependencies": {
    "prettier": "^3.8.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "prettier": "@theahaco/ts-config/prettier"
}
